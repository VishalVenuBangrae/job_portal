{
  "name": "job_portal",
  "version": "1.0.0",
  "description": "Nauti Crew Agency yacht daywork matching portal",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "setup": "node setup-dev.js",
    "setup:locations": "node setup-locations.js",
    "test:ports": "node test-all-ports.js",
    "test:api": "node test-api-integration.js",
    "test:basic": "node test-simple-api.js",
    "sync:ports": "node sync-yacht-ports.js",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "security:check": "npm audit --audit-level=high",
    "test:security": "npm run security:check && npm run security:audit",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/matching.test.js",
    "preview": "node scripts/preview.js"
  },
  "author": "Vishal Venu Bangrae",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^10.0.3",
    "nodemon": "^3.1.9",
    "twilio": "^4.23.0",
    "validator": "^13.12.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
